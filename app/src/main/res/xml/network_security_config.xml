<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Local stream server runs on 127.0.0.1; some self-hosted addons use plain http -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
